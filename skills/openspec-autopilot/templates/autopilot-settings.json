{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node <SKILL_DIR>/scripts/autopilot-hook.mjs",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node <SKILL_DIR>/scripts/autopilot-hook.mjs",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git reset:*)",
      "Bash(flows-cli:*)",
      "Bash(lark-cli:*)",
      "Edit(**/decisions/autopilot.json)",
      "Edit(**/decisions/D-*.json)",
      "Edit(//<AUTOPILOT_HOME>/**)"
    ]
  }
}
